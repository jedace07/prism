{
  "app-id": "io.github.prismviewer.Prism",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "26.08",
  "command": "prism",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=xdg-pictures:ro",
    "--env=GTK_USE_PORTAL=1",
    "--env=XCURSOR_PATH=/run/host/user-share/icons:/run/host/share/icons"
  ],
  "modules": [
    {
      "name": "prism",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/prism",
        "cp -a prism/. /app/lib/prism/",
        "install -Dm755 desktop/prism /app/bin/prism",
        "install -Dm644 desktop/io.github.prismviewer.Prism.desktop /app/share/applications/io.github.prismviewer.Prism.desktop",
        "install -Dm644 desktop/io.github.prismviewer.Prism.metainfo.xml /app/share/metainfo/io.github.prismviewer.Prism.metainfo.xml",
        "install -Dm644 desktop/io.github.prismviewer.Prism.svg /app/share/icons/hicolor/scalable/apps/io.github.prismviewer.Prism.svg",
        "install -Dm644 /app/lib/prism/resources/app/LICENSE /app/share/licenses/io.github.prismviewer.Prism/LICENSE",
        "install -Dm644 /app/lib/prism/resources/app/NOTICE /app/share/licenses/io.github.prismviewer.Prism/NOTICE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../dist/Prism-linux-x64",
          "dest": "prism"
        },
        {
          "type": "dir",
          "path": "desktop",
          "dest": "desktop"
        }
      ]
    }
  ]
}
