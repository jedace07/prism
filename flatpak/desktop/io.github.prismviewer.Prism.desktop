[Desktop Entry]
Type=Application
Name=Prism
GenericName=Image Viewer
Comment=View local images with GPU rendering and broad format support
Exec=prism %F
Icon=io.github.prismviewer.Prism
Terminal=false
Categories=Graphics;Viewer;Photography;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/bmp;image/svg+xml;image/x-icon;image/avif;
StartupNotify=true
StartupWMClass=Prism
DBusActivatable=false
